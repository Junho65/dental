{
  "metadata": {
    "description": "Table-ready hyperparameter summary for the current project pipeline (4-class main detector, 2-class periodontal detector, periodontal BL/FI severity classifiers).",
    "column_schema": [
      "Category",
      "Parameter",
      "Value/Description"
    ],
    "sources": {
      "main_detection_script_defaults": [
        "scripts/training/train_detection.py",
        "README.md",
        "ARCHITECTURE.md"
      ],
      "main_detection_served_finetune": [
        "scripts/training/run_pediatric_service_finetune.py"
      ],
      "periodontal_detection_recorded_args": [
        "runs/detect/artifacts/detection/yolov8s_periodontal_2class_bg_img640/run01/args.yaml"
      ],
      "severity_script_defaults": [
        "scripts/training/train_severity_classifier.py",
